# Application
APP_ENV=development                    # development|staging|production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=dev-secret-key-for-local-development-only-32chars-minimum
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Database (Docker service name: postgres)
DATABASE_URL=postgresql+asyncpg://grok:grok@postgres:5432/grok
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5

# Redis (Docker service name: redis)
REDIS_URL=redis://redis:6379/0

# Google OAuth (Phase 1+)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
GOOGLE_SCOPES_READONLY=openid,email,profile,gmail.readonly,calendar.readonly,tasks.readonly

# Encryption (application-level, key NOT in database)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=ZGV2LWVuY3J5cHRpb24ta2V5LWZvci1sb2NhbC1kZXZlbG9wbWVudC1vbmx5
ENCRYPTION_ALGORITHM=AES-256-GCM

# AI Provider (choose one)
AI_PROVIDER=mock                     # nemotron|openai|mock
NEMOTRON_API_URL=http://host.docker.internal:8000/v1
NEMOTRON_API_KEY=
NEMOTRON_MODEL=nemotron-3-ultra
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=4096

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Sync Intervals (minutes)
SYNC_GMAIL_INTERVAL=5
SYNC_CALENDAR_INTERVAL=5
SYNC_TASKS_INTERVAL=15

# Briefing
BRIEFING_DEFAULT_TIME=07:00

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json